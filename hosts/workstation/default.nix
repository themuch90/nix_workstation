# =====================================================================
#  HOST: workstation
#  This is the ONLY file where machine-specific values are set.
#  Each "my.*" block corresponds to a module in ../../modules
# =====================================================================
{ ... }:
{
  imports = [
    ./hardware-configuration.nix   # generated by nixos-generate-config
    # the my.* modules are added by mkHost (flake.nix): this folder can be
    # copied as-is into a PC-specific repository (wiki: Repository-del-PC)
  ];

  # ---------------------------------------------------------------
  # System base (modules/core)
  # ---------------------------------------------------------------
  my.core = {
    # >>> MACHINE NAME <<<
    # max 15 characters: letters, digits, hyphen (NetBIOS/AD limit).
    # It is the name the PC joins the domain with: if you change it after
    # the join, run "sudo ad-join <user>" again.
    hostName = "workstation";

    timeZone = "Europe/Rome";
    locale = "it_IT.UTF-8";
    keyboardLayout = "it";
    vpnPlugins = true;   # OpenVPN, OpenConnect, L2TP, vpnc... VPNs (WireGuard is always available)
  };

  # ---------------------------------------------------------------
  # Local administrator user (modules/users/local-admin.nix)
  # ---------------------------------------------------------------
  my.users.localAdmin = {
    enable = true;
    name = "localadmin";
    # Initial plain-text password: CHANGE IT after the first boot.
    password = "CHANGEME";
    # Recommended: SHA-512 hash (takes precedence over password)
    #   nix-shell -p mkpasswd --run 'mkpasswd -m sha-512'
    # hashedPassword = "$6$...";
    # Root password (default: none). Needed to log into the Proxmox Web UI
    # as root@pam (real USB/PCI devices, restoring backups that use them).
    # Same mkpasswd command as above.
    # rootHashedPassword = "$6$...";
  };

  # ---------------------------------------------------------------
  # Active Directory (modules/identity/active-directory.nix)
  # >>> REPLACE with your domain's details <<<
  # ---------------------------------------------------------------
  my.activeDirectory = {
    enable = true;
    domain = "example.local";            # AD DNS domain (lowercase)
    # realm = "EXAMPLE.LOCAL";           # default: domain in uppercase
    # domainControllers = [ "dc01.example.local" ];  # empty = DNS autodiscovery
    sudoGroups = [ "domain admins" ];    # AD groups that become administrators
    # sudoUsers = [ "john.doe" ];        # individual AD users as administrators
    # allowedGroups = [ "workstation-users" ];  # empty = all AD users
  };

  # ---------------------------------------------------------------
  # Drivers and firmware (modules/hardware/drivers.nix)
  # To find out what to enable on this PC:  sudo driver-check
  # (analyses the hardware and prints the block to paste here)
  # ---------------------------------------------------------------
  my.hardware.drivers = {
    enable = true;
    # intel.enable = true;          # Intel graphics: video acceleration
    # amd.enable = true;            # AMD graphics
    # nvidia = {
    #   enable = true;
    #   driver = "stable";          # legacy_580 for Maxwell/Pascal (wiki: Driver-e-firmware)
    #   open = true;                # false for GPUs older than GTX 16xx
    #   prime = {                   # hybrid laptops
    #     enable = true;
    #     intelBusId = "PCI:0:2:0";
    #     nvidiaBusId = "PCI:1:0:0";
    #   };
    # };
    # bluetooth = true;  printers = true;  scanners = true;   # default
  };

  # ---------------------------------------------------------------
  # Desktop (modules/desktop)
  # ---------------------------------------------------------------
  my.desktop.plasma = {
    enable = true;
    numlock = true;          # Num Lock on at boot
    dolphinDetailsView = true;   # Dolphin in Details view for all folders
    raiseNewWindows = true;      # a program opened from a link/file comes to the foreground
  };

  # ---------------------------------------------------------------
  # Applications (modules/apps) - set false to disable one
  # ---------------------------------------------------------------
  my.apps = {
    firefox.enable = true;
    # onlyoffice.enable = true;     # disabled: replaced by Office 365
    office365 = {
      enable = true;
      apps = [ "word" "excel" "powerpoint" "outlook" "teams" "onedrive" ];
    };
    localsend.enable = true;
    vscode.enable = true;
    whatsapp.enable = true;
    freerdp.enable = true;
    pinta.enable = true;            # drawing and photo editing
    naps2.enable = true;            # scan documents to PDF
    haruna.enable = true;           # video player (default for videos)
    obsstudio.enable = true;        # screen recording and streaming
    solidcraft.enable = true;       # 3D parametric CAD (built from source: slow first rebuild)
    prusaslicer.enable = true;      # slicer for 3D printing
    bambustudio.enable = false;     # Bambu Lab slicer (built from source: slow first rebuild)
  };

  # ---------------------------------------------------------------
  # Virtualization (modules/virtualization)
  # ---------------------------------------------------------------
  my.virtualization = {
    proxmox = {
      enable = true;
      # root@pam login: see rootHashedPassword in my.users.localAdmin
    };

    vmNetwork = {
      enable = true;
      bridge = "vmbr1";
      network = "172.30.20.0";    # VM network
      address = "172.30.20.1";    # host IP on the VM network (VM gateway)
      prefixLength = 24;          # 172.30.20.0/24
      dhcp = {
        enable = true;
        rangeStart = "172.30.20.100";
        rangeEnd = "172.30.20.250";
      };
    };
  };

  # VMware Workstation-style interface: RDP (xfreerdp) and SSH (terminal) consoles
  my.vmstation.enable = true;

  # ---------------------------------------------------------------
  # Maintenance (modules/maintenance)
  # Daily update check (nixpkgs + proxmox-nixos)
  # with desktop notification. Apply with: sudo system-update
  # ---------------------------------------------------------------
  my.maintenance.updateCheck = {
    enable = true;
    flakePath = "/etc/nixos";        # where this repository lives
    time = "*-*-* 10:00:00";         # every day at 10:00 (or at boot if missed)
    # notifyUsers = [ "localadmin" ];  # empty = all logged-in users
    keepGenerations = 5;             # default proposed by "sudo system-clean"
    keepPrevious = 2;                # after system-update / config-sync: previous versions kept (min 2), older ones deleted
    vaultCredentialsFile = "git-credentials";  # git login in the KDE Vault (config-update)
  };

  # Automatic alignment with this PC's repository: change the configuration on
  # the git server and the PC applies it by itself (or now: remote-update pc01).
  # Needs gitCredentialsFile (a token: unattended runs have no KDE Vault).
  my.maintenance.configSync = {
    enable = false;
    interval = "15min";              # how often the PC repository is checked
  };

  # Do not change after the first installation (see the NixOS manual)
  system.stateVersion = "26.05";
}
